{
    "name": "mininterval-runner",
    "version": "0.2.1",
    "private": false,
    "description": "Repeated execution with minimum interval control.",
    "keywords": [
        "loop",
        "repeat",
        "task",
        "timer"
    ],
    "homepage": "https://magiclen.org/mininterval-runner/",
    "bugs": {
        "url": "https://github.com/magiclen/mininterval-runner/issues"
    },
    "license": "MIT",
    "author": "Magic Len",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/magiclen/mininterval-runner.git"
    },
    "files": [
        "lib"
    ],
    "type": "module",
    "types": "./lib/index.d.ts",
    "exports": "./lib/index.js",
    "scripts": {
        "test": "tsx --test",
        "clean": "rimraf lib",
        "build": "npm run clean && tsc -p tsconfig.build.json",
        "build:watch": "npm run build -- -w",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "knip": "knip",
        "check": "npm run lint && npm run format:check && npm run knip",
        "prepare": "node setup-git-hooks.mjs",
        "prepack": "npm run build",
        "prepublishOnly": "npm run check && npm run test"
    },
    "devDependencies": {
        "@types/node": "^24.13.5",
        "knip": "^6.35.1",
        "oxfmt": "^0.68.0",
        "oxlint": "^1.83.0",
        "oxlint-tsgolint": "^7.0.2001",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=24"
    }
}
